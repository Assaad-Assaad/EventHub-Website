@using System.Globalization
@using EventHubWebsite
@using EventHubWebsite.Entities
@using EventHubWebsite.Models
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer ViewLocalizer
@model IEnumerable<EventHubWebsite.Entities.Category>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <h1 class="display-4 fw-bold text-white">@ViewLocalizer["Welcome to EventHubWebsite"]</h1>
        <p class="lead text-white mb-4">@ViewLocalizer["Discover amazing events around the world"]</p>
        <a href="#Events" class="btn btn-primary btn-lg">@ViewLocalizer["Explore Events"]</a>
    </div>
</section>

<!-- Events Section -->
<section id="Events" class="events-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <i class="fas fa-laptop-code text-primary me-2"></i>
            <h2 class="display-5 fw-bold">@ViewLocalizer["Events"]</h2>
            <p class="lead text-muted">@ViewLocalizer["Browse our event categories"]</p>
        </div>

        <div class="row">
            @{
                var items = Model.ToList();
            }

            @for (int i = 0; i < items.Count; i += 4)
            {
                <div class="row g-4">
                    @for (int j = i; j < i + 4 && j < items.Count; j++)
                    {
                        var item = items[j];
                        <div class="col-md-3">
                            <div class="card h-100 shadow-sm">
                                <img src="@item.ImagePath" class="card-img-top" alt="@item.Name">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">@item.Name</h5>
                                    <p class="card-text text-muted">@item.Description</p>
                                    <a asp-controller="Events" asp-action="AllEvents" asp-route-categoryId="@item.Id" 
                                       class="btn btn-primary btn-sm w-100">@ViewLocalizer["Explore more Events"]</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- Contact Us Section -->
<section id="ContactUs" class="contact-section py-5 bg-light">
    <div class="container">
        <div class="section-header text-center mb-5">
            <i class="fas fa-phone-alt text-primary me-2"></i>
            <h2 class="display-5 fw-bold">@ViewLocalizer["Contact Us"]</h2>
            <p class="lead text-muted">@ViewLocalizer["Get in touch with us"]</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-body p-5">
                        <form>
                            <div class="mb-4">
                                <label for="Name" class="form-label">@ViewLocalizer["Name"]</label>
                                <input type="text" class="form-control" id="Name" placeholder="@ViewLocalizer["Your name"]">
                            </div>
                            <div class="mb-4">
                                <label for="Email" class="form-label">@ViewLocalizer["Email"]</label>
                                <input type="email" class="form-control" id="Email" placeholder="@ViewLocalizer["Your email"]">
                            </div>
                            <div class="mb-4">
                                <label for="Subject" class="form-label">@ViewLocalizer["Subject"]</label>
                                <input type="text" class="form-control" id="Subject" placeholder="@ViewLocalizer["Subject"]">
                            </div>
                            <div class="mb-4">
                                <label for="MessageBody" class="form-label">@ViewLocalizer["Message"]</label>
                                <textarea class="form-control" id="MessageBody" rows="5" placeholder="@ViewLocalizer["Your message"]"></textarea>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">@ViewLocalizer["Send Message"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Us Section -->
<section id="AboutUs" class="about-section py-5">
    <div class="container">
        <div class="section-header text-center mb-5">
            <i class="fas fa-chalkboard-teacher text-primary me-2"></i>
            <h2 class="display-5 fw-bold">@ViewLocalizer["About Us"]</h2>
            <p class="lead text-muted">@ViewLocalizer["Learn more about us"]</p>
        </div>

        <div class="row align-items-center">
            <div class="col-lg-6">
                <p class="lead text-muted mb-4">
                    @ViewLocalizer["EventHubWebsite is a platform where you can find all the events around the world"]
                </p>
                <p class="text-muted">
                    @ViewLocalizer["Join our community and stay updated with the latest events"]
                </p>
            </div>
            <div class="col-lg-6">
                <img src="/images/about-us.jpg" alt="About Us" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>
